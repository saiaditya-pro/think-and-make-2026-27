DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev defaults to SQLite. For staging/prod, point at Supabase Postgres:
# DATABASE_URL=postgres://user:password@db.<project>.supabase.co:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to True + fill in the Supabase Storage (S3-compatible) credentials below
# once a bucket exists; local dev without these just writes to ./media.
USE_S3_STORAGE=False
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=think-and-make
SUPABASE_STORAGE_ENDPOINT_URL=
SUPABASE_STORAGE_REGION=ap-south-1

GEMINI_API_KEY=
