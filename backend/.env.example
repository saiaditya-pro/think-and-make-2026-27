DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: Supabase Postgres ---
# Supabase dashboard -> Connect -> "Session pooler" string (works on IPv4; the
# "Direct connection" host is IPv6-only and often times out on home networks).
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F.
# Leave unset to fall back to the local SQLite file (backend/db.sqlite3).
# Every table gets Row Level Security turned on after `migrate`, so the
# Supabase Data API (anon key) can't read them; Django is unaffected.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to True + fill in the Supabase Storage (S3-compatible) credentials below
# once a bucket exists; local dev without these just writes to ./media.
USE_S3_STORAGE=False
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=think-and-make
SUPABASE_STORAGE_ENDPOINT_URL=
SUPABASE_STORAGE_REGION=ap-south-1

GEMINI_API_KEY=

# --- Google Sheets live sync (python manage.py sync_google_sheets / Celery beat) ---
# 1. Google Cloud console: enable the Google Sheets API, create a service account,
#    download its JSON key into backend/secrets/ (gitignored).
# 2. Share the master sheet AND every partner sheet in its PartnerConfig tab
#    with the service account's email (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Or paste the whole key JSON instead (for hosts without a writable disk):
# GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID from the T&M_PWA_Master sheet's URL (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_MASTER_SHEET_ID=
SHEETS_SYNC_ENABLED=True
SHEETS_SYNC_INTERVAL_MIN=15
SHEETS_SYNC_YEAR=2026
